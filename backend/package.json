{
  "name": "flutter-car-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express API for the Flutter car application. Owns application/user data only; the car catalog and AI features are provided by external services.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:watch": "node --watch src/server.js",
    "check": "node --check src/server.js",
    "db:check": "node scripts/check-db.js",
    "catalog:check": "node scripts/check-catalog.js",
    "ai:check": "node scripts/check-ai.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
