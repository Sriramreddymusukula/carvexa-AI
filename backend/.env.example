# ---------------------------------------------------------------------------
# flutter-car-backend — environment template (PLACEHOLDERS ONLY)
# ---------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in real values.
#   .env is git-ignored and must NEVER be committed.
#   Never put a real secret in this file.

# --- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
# HTTP port for the Express server
PORT=4000

# --- MongoDB Atlas ---------------------------------------------------------
# Get the connection string from Atlas -> Connect -> Drivers.
# URL-encode the password if it contains characters such as @ : / # %
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# Optional. If omitted, the database from MONGODB_URI is used.
MONGODB_DB_NAME=<database-name>

# Connect timeout in milliseconds.
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# Signing key for 30-day bearer sessions. Set a random value of at least 32
# characters in backend/.env; production startup rejects an empty/short value.
AUTH_TOKEN_SECRET=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins for the Flutter web/debug
# client. Native Android/iOS requests send no Origin header and are allowed.
# Do not use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Logging ---------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# Log request/response metadata (paths, status, timing). Never logs bodies,
# headers or query strings, so customer PII and secrets stay out of the logs.
HTTP_REQUEST_LOGGING=true

# --- External car catalog API ---------------------------------------------
# The car data API is a third-party service that requires a key. The key is a
# SERVER-SIDE SECRET: it is read by the backend only and is never sent to the
# Flutter app, never logged, and never returned in an API response.
#
# Copy these into backend/.env and fill in the real values there.
# NEVER put a real key in this file — this file is committed.

# Which provider adapter talks to the catalog. `none` disables the feature
# cleanly. Supported now: `parse-cardekho` (CarDekho via the Parse marketplace).
CAR_CATALOG_PROVIDER=none

# Provider API root, without a trailing slash, e.g. https://api.parse.bot
CAR_CATALOG_BASE_URL=

# The provider's catalog identifier. For Parse this is the shared canonical
# "scraper id" from the marketplace listing — public, not a secret.
CAR_CATALOG_SCRAPER_ID=

# The provider key. PASTE IT IN backend/.env, NOT HERE.
CAR_CATALOG_API_KEY=

# How the key is carried on the wire.
# A header name (X-API-Key, Authorization, ...) or query param name.
CAR_CATALOG_API_KEY_HEADER=X-API-Key
CAR_CATALOG_API_KEY_QUERY_PARAM=
# Optional prefix for the header value, e.g. "Bearer " (note the space).
CAR_CATALOG_API_KEY_SCHEME=

# Timeout for one provider call, and how long a provider response is cached in
# memory (keeps us inside a free-tier quota and makes repeat screens instant).
CAR_CATALOG_TIMEOUT_MS=10000
CAR_CATALOG_CACHE_TTL_MS=60000

# Default page size requested from the provider.
CAR_CATALOG_PAGE_SIZE=20

# --- Gemini AI (server-side only) ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000

# --- Lead notification email (server-side only) ----------------------------
# Optional provider. With `none`, leads are still stored and the API reports
# `emailNotification.status: not_configured`.
# `resend` sends through https://resend.com using its HTTPS API.
EMAIL_PROVIDER=none
RESEND_API_KEY=
# Resend-verified sender, e.g. Carvexa AI <leads@your-verified-domain.com>
EMAIL_FROM=
# Defaults to the requested lead recipient. Override only if needed.
LEAD_NOTIFICATION_EMAIL=sriramreddymusukula@gmail.com

